# Server
PORT=3000
HOST=0.0.0.0
APP_SECRET=replace-with-a-long-random-secret
# DB_FILE=/workspace/data/app.db
# Public base URL used to generate embed snippet, e.g. https://chat.example.com
# PUBLIC_BASE=
# Optional IP geo provider, {ip} placeholder; falls back to bundled ip2region
# GEO_API=https://restapi.amap.com/v3/ip?key=YOUR_KEY&ip={ip}
# ip2region address families (4,6)
# GEO_FAMILIES=4,6
# GEO_DEBUG=1

# Alipay computer website payment
# ALIPAY_APP_ID=
# ALIPAY_PRIVATE_KEY=
# ALIPAY_PRIVATE_KEY_FILE=/workspace/alipay_private_key.pem
# ALIPAY_PUBLIC_KEY=
# ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
# ALIPAY_KEY_TYPE=PKCS8
# ALIPAY_NOTIFY_URL=https://your-domain/api/public/payments/alipay/notify
# ALIPAY_RETURN_URL=https://your-domain/api/public/payments/alipay/return
# ALIPAY_SELLER_ID=
